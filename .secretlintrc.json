{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "absolute home path",
            "patterns": [
              "/(?<![\\w.-])\\/(?:Users|home)\\/[A-Za-z0-9._-]+/",
              "/\\b[A-Za-z]:(?:\\\\){1,2}Users(?:\\\\){1,2}[A-Za-z0-9._-]+/"
            ],
            "allows": ["/^\\/Users\\/someone$/"]
          },
          {
            "name": "encoded home path",
            "patterns": ["/(?<=^|[\\/\\\\\\s\"'`(])-?Users-[A-Za-z0-9._]+-/m"]
          }
        ]
      }
    }
  ]
}
